HOST=127.0.0.1
# Required for production/public binding. Use a separate random secret, not the football-data token.
API_ACCESS_TOKEN=
PORT=3000
# Exact Vercel origin, no trailing slash. For local frontend development: http://localhost:4173
FRONTEND_ORIGINS=
DATABASE_PATH=./data/futuro.sqlite
# Optional: use PostgreSQL application storage; blank keeps local SQLite.
# Never put a real connection URL in this template.
DATABASE_URL=
MODEL_URL=http://127.0.0.1:8001
# Local training uses Python directly, without the scoring HTTP service.
PYTHON_EXECUTABLE=python
ARTIFACT_DIRECTORY=./data/artifacts
# Optional free football-data.org token. Never commit a real token.
FOOTBALL_DATA_TOKEN=
# In-process scheduling for a machine that stays running; use false with the hosted GitHub schedule.
AUTOMATION_ENABLED=true
AUTOMATION_COMPETITIONS=PL,PD,BL1,SA,FL1,CL,EL,ECL,UNL,WCQ_EU,WC
AUTOMATION_INTERVAL_HOURS=6
AUTOMATION_HORIZON_HOURS=24
AUTOMATION_POLICY_VERSION=daily-v1
# Leave blank to keep the baseline. Use only a completed trained model ID.
AUTOMATION_MODEL_ID=
